                <data android:host="*.engadget.com" />
                <data android:host="eurogamer.net" />
                <data android:host="*.eurogamer.net" />
                <data android:host="fastcompany.com" />
                <data android:host="*.fastcompany.com" />
                <data android:host="forbes.com" />
