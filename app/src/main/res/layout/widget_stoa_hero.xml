<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_root_bg"
    android:clipChildren="true"
    android:clipToOutline="true">

    <!-- Solid, paper, or hero image background rendered as a physical rounded bitmap -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_paper" />

    <!-- Content overlay -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Bar: STOA + Unread Count Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="STOA"
                android:textColor="#141413"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Unread Badge -->
            <FrameLayout
                android:id="@+id/widget_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/widget_badge_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_badge_bg" />

                <TextView
                    android:id="@+id/widget_unread_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="12 unread"
                    android:textColor="#EEEAE1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Main Headline -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="Latest story headline from your followed publications"
            android:textColor="#141413"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.15" />

        <!-- Meta row: Source · Time -->
        <TextView
            android:id="@+id/widget_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="DEZEEN · 2 hr ago"
            android:textColor="#6B665C"
            android:textSize="12sp"
            android:textStyle="normal" />

    </LinearLayout>

</FrameLayout>
